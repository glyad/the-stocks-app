{
  "build": {
    "beforeBuildCommand": "npm run typecheck && vite build --mode e2e"
  },
  "app": {
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "wdio-e2e",
          "windows": ["main"],
          "permissions": ["wdio:default", "wdio-webdriver:default"]
        }
      ]
    },
    "withGlobalTauri": true
  }
}
