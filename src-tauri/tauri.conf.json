{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "The Stocks App",
  "version": "0.1.0",
  "identifier": "com.example.the-stocks-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "The Stocks App",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://www.alphavantage.co; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
